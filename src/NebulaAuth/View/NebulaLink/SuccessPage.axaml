<!-- Short success animation (static with Settings.ReduceMotion), then the accounts table. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:pages="using:NebulaAuth.ViewModel.NebulaLink.Pages"
             x:Class="NebulaAuth.View.NebulaLink.SuccessPage"
             x:DataType="pages:SuccessPageVM">
    <UserControl.Styles>
        <Style Selector="Border.SuccessBadge">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="76" />
            <Setter Property="CornerRadius" Value="38" />
            <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
            <Setter Property="RenderTransform">
                <ScaleTransform />
            </Setter>
        </Style>
        <Style Selector="Border.SuccessBadge.Animate">
            <Style.Animations>
                <Animation Duration="0:0:0.45" Easing="BackEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.6" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <StackPanel Classes="Page" Margin="24,36,24,40" Spacing="14">
        <Border Classes="SuccessBadge" Classes.Animate="{Binding Animate}" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="CheckBold" IconSize="40" Foreground="{DynamicResource SuccessTextBrush}" />
        </Border>
        <TextBlock Classes="StepTitle" HorizontalAlignment="Center" TextAlignment="Center"
                   Text="{Tr NebulaLink.Success.Title}" />
        <TextBlock Classes="Lead" TextAlignment="Center" Text="{Tr NebulaLink.Success.Text}" />
    </StackPanel>
</UserControl>
