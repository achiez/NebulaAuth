<!--
    Encryption password prompt on startup (MainWindow.ShowSetPasswordDialog). Result: true/false (OK/Cancel or the
    header X); the password is read from the bound VM afterwards.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="using:NebulaAuth.Core"
             xmlns:nebulaAuth="using:NebulaAuth"
             xmlns:other="using:NebulaAuth.ViewModel.Other"
             mc:Ignorable="d"
             x:Class="NebulaAuth.View.Dialogs.SetCryptPasswordDialog"
             x:DataType="other:SetEncryptPasswordVM"
             MinWidth="380" MaxWidth="500">
    <Grid RowDefinitions="Auto,Auto">
        <nebulaAuth:DialogHeader Grid.Row="0" IconKind="Encryption"
                                 Title="{Tr SetEncryptionPasswordDialog.Title}"
                                 CloseParameter="{x:False}" />
        <StackPanel Grid.Row="1" Classes="DialogBody">
            <TextBlock Classes="DialogText"
                       Text="{Tr SetEncryptionPasswordDialog.DialogText}" />
            <StackPanel Classes="Field">
                <TextBlock Classes="FieldLabel" Text="{Tr SetEncryptionPasswordDialog.Password}" />
                <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•"
                         Classes="revealPasswordButton" />
            </StackPanel>
            <StackPanel Classes="DialogActions">
                <Button Theme="{DynamicResource SolidButton}" Classes="Primary"
                        Content="{Tr SetEncryptionPasswordDialog.Ok}"
                        IsDefault="True"
                        Command="{x:Static core:DialogService.CloseDialogCommand}"
                        CommandParameter="{x:True}" />
                <Button Theme="{DynamicResource OutlineButton}" Classes="Tertiary"
                        Content="{Tr SetEncryptionPasswordDialog.Cancel}"
                        IsCancel="True"
                        Command="{x:Static core:DialogService.CloseDialogCommand}"
                        CommandParameter="{x:False}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
