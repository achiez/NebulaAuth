<!--
    Password of mafiles encrypted by Steam Desktop Authenticator (DialogsController.ShowSdaPasswordDialog, used by the
    mafile import). Result: true/false; the password is read from the bound VM afterwards.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="using:NebulaAuth.Core"
             xmlns:nebulaAuth="using:NebulaAuth"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:other="using:NebulaAuth.ViewModel.Other"
             mc:Ignorable="d"
             x:Class="NebulaAuth.View.Dialogs.SdaPasswordDialog"
             x:DataType="other:SdaPasswordDialogVM"
             MinWidth="380" MaxWidth="500">
    <Grid RowDefinitions="Auto,Auto">
        <nebulaAuth:DialogHeader Grid.Row="0" IconKind="Lock"
                                 Title="{Tr SdaPasswordDialog.Title}"
                                 CloseParameter="{x:False}" />
        <StackPanel Grid.Row="1" Classes="DialogBody">
            <TextBlock Classes="DialogText" Text="{Tr SdaPasswordDialog.Message}" />
            <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•"
                     Classes="revealPasswordButton" FontSize="14"
                     PlaceholderText="{Tr SdaPasswordDialog.PasswordHint}">
                <TextBox.InnerLeftContent>
                    <mi:MaterialIcon Classes="InputIcon" Kind="Key" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <nebulaAuth:PasswordHints Target="{Binding #PasswordBox}" Margin="2,-6,2,0" />
            <StackPanel Classes="DialogActions">
                <Button Theme="{DynamicResource SolidButton}" Classes="Primary"
                        Content="{Tr Common.OK}"
                        IsEnabled="{Binding IsFormValid}"
                        IsDefault="True"
                        Command="{x:Static core:DialogService.CloseDialogCommand}"
                        CommandParameter="{x:True}" />
                <Button Theme="{DynamicResource OutlineButton}" Classes="Tertiary"
                        Content="{Tr Common.Cancel}"
                        IsCancel="True"
                        Command="{x:Static core:DialogService.CloseDialogCommand}"
                        CommandParameter="{x:False}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
