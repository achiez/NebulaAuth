<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="using:NebulaAuth.Core"
             xmlns:model="using:NebulaAuth.Model"
             xmlns:other="using:NebulaAuth.ViewModel.Other"
             xmlns:nebulaAuth="using:NebulaAuth"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:scg="using:System.Collections.Generic"
             xmlns:sys="using:System"
             mc:Ignorable="d"
             d:DesignHeight="650"
             x:Class="NebulaAuth.View.SettingsView"
             x:DataType="other:SettingsVM"
             Width="480"
             MinHeight="400"
             FontSize="14">
    <UserControl.Styles>
        <!-- Dialog text size 14 (Semi CheckBox/ComboBox default sizes differ) -->
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <!-- Slider label row: caption on the left, current value on the right -->
        <Style Selector="TextBlock.SliderValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="Margin" Value="0,-4,0,0" />
        </Style>
        <!-- The visible track of the HideActiveTrack sliders comes from the app style + SliderTrackBackground (ThemeResources) -->
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <nebulaAuth:DialogHeader Grid.Row="0"
                                 IconKind="Settings"
                                 Title="{Tr SettingsDialog.Title}"
                                 IsCloseEnabled="{Binding !ApplyRenameSettingCommand.IsRunning}" />

        <TabControl Grid.Row="1" x:Name="SettingsTabs" Classes="Uniform" Padding="0">

            <!-- ===== Main ===== -->
            <TabItem Header="{Tr SettingsDialog.MainSettings}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <!-- Spacing 22 between groups: the groups differ in kind (select, check boxes, password, action) -->
                    <StackPanel Classes="Form" Spacing="22" Margin="24,20,24,24">
                        <StackPanel Classes="Field">
                            <TextBlock Classes="FieldLabel" Text="{Tr LanguageWord}" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedValue="{Binding Language}"
                                      SelectedValueBinding="{Binding Key, DataType={x:Type scg:KeyValuePair, x:TypeArguments='core:LocalizationLanguage, x:String'}}"
                                      DisplayMemberBinding="{Binding Value, DataType={x:Type scg:KeyValuePair, x:TypeArguments='core:LocalizationLanguage, x:String'}}" />
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <CheckBox IsChecked="{Binding HideToTray}"
                                      Content="{Tr SettingsDialog.MinimizeToTray}" />
                            <CheckBox IsChecked="{Binding ConfirmMafileImport}"
                                      Content="{Tr SettingsDialog.ConfirmMafileImport}"
                                      ToolTip.Tip="{Tr SettingsDialog.ConfirmMafileImportHint}" />
                            <!-- AllowAutoUpdate stays hidden -->
                            <CheckBox IsChecked="{Binding UseIcon}"
                                      Content="{Tr SettingsDialog.UseIndicator}"
                                      ToolTip.Tip="{Tr SettingsDialog.UseIndicatorHint}" />
                            <!-- Hue bar + swatch opening the full picker. The picker holds the binding to IconColor,
                                 the hue bar follows the picker. -->
                            <Grid ColumnDefinitions="*,12,Auto" Margin="0,2,0,0"
                                  IsVisible="{Binding UseIcon}">
                                <ColorSlider Grid.Column="0"
                                             VerticalAlignment="Center"
                                             ColorModel="Hsva"
                                             ColorComponent="Component1"
                                             IsPerceptive="True"
                                             IsAlphaVisible="False"
                                             Color="{Binding #IconColorPicker.Color, Mode=TwoWay}" />
                                <ColorPicker x:Name="IconColorPicker"
                                             Grid.Column="2"
                                             VerticalAlignment="Center"
                                             IsAlphaEnabled="False"
                                             IsAlphaVisible="False"
                                             Color="{Binding IconColor, Converter={StaticResource NullableColorConverter}, Mode=TwoWay, Delay=50}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Classes="Field">
                            <TextBlock Classes="FieldLabel" Text="{Tr SettingsDialog.PasswordBox.CurrentCryptPassword}" />
                            <Grid ColumnDefinitions="*,6,Auto">
                                <TextBox Grid.Column="0"
                                         MinWidth="250"
                                         Text="{Binding Password}"
                                         PasswordChar="•"
                                         Classes="revealPasswordButton">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SetPasswordCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="2"
                                        Theme="{StaticResource GhostIconButton}"
                                        Classes="Primary"
                                        Command="{Binding SetPasswordCommand}"
                                        ToolTip.Tip="{Tr Common.Save}">
                                    <mi:MaterialIcon Kind="ContentSave" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="FieldHelper" Text="{Tr SettingsDialog.PasswordBox.Hint}" />
                        </StackPanel>

                        <StackPanel Classes="Field">
                            <TextBlock Classes="FieldLabel" Text="{Tr SettingsDialog.MafileNamingMode}" />
                            <ComboBox SelectedItem="{Binding UseAccountNameAsMafileNamePreview}">
                                <x:Boolean>True</x:Boolean>
                                <x:Boolean>False</x:Boolean>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="sys:Boolean">
                                        <TextBlock Text="{Binding Converter={StaticResource BoolToMafileNamingConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Panel Margin="0,6,0,0">
                                <Button Theme="{DynamicResource OutlineButton}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ApplyRenameSettingCommand}"
                                        Content="{Tr SettingsDialog.ApplyNamingMode}" />
                                <!-- Rename progress -->
                                <ProgressBar Height="3" MinHeight="3" Margin="6,0,6,1"
                                             VerticalAlignment="Bottom"
                                             Minimum="0" Maximum="1"
                                             Value="{Binding RenameMafilesProgress}"
                                             IsHitTestVisible="False"
                                             IsVisible="{Binding ApplyRenameSettingCommand.IsRunning}" />
                            </Panel>
                        </StackPanel>

                        <nebulaAuth:HintBox FontSize="13"
                                            Text="{Binding RenameResultText}"
                                            IsVisible="{Binding RenameResultText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Theme ===== -->
            <TabItem Header="{Tr SettingsDialog.ThemeSettings}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Classes="Form" Margin="24,16,24,24">
                        <StackPanel Classes="Field">
                            <TextBlock Classes="FieldLabel" Text="{Tr SettingsDialog.Theme.CurrentTheme}" />
                            <ComboBox ItemsSource="{Binding ThemeTypes}"
                                      SelectedValue="{Binding ThemeType}"
                                      SelectedValueBinding="{Binding Key, DataType={x:Type scg:KeyValuePair, x:TypeArguments='model:ThemeType, x:String'}}"
                                      DisplayMemberBinding="{Binding Value, DataType={x:Type scg:KeyValuePair, x:TypeArguments='model:ThemeType, x:String'}}" />
                        </StackPanel>

                        <StackPanel Classes="Field">
                            <TextBlock Classes="FieldLabel" Text="{Tr SettingsDialog.BackgroundHint}" />
                            <!-- Same texts as SettingsVM.BackgroundModes, but through {Tr} so they follow a live language switch -->
                            <ComboBox SelectedValue="{Binding BackgroundMode}"
                                      SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}">
                                <ComboBoxItem Tag="{x:Static model:BackgroundMode.Default}"
                                              Content="{Tr SettingsDialog.BackgroundMode.Default}" />
                                <ComboBoxItem Tag="{x:Static model:BackgroundMode.Custom}"
                                              Content="{Tr SettingsDialog.BackgroundMode.Custom}" />
                                <ComboBoxItem Tag="{x:Static model:BackgroundMode.Color}"
                                              Content="{Tr SettingsDialog.BackgroundMode.NoBackground}" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Sliders: while one is dragged the dialog turns almost transparent (code-behind) -->
                        <StackPanel Classes="Field">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="FieldLabel" Text="{Tr SettingsDialog.Theme.BackgroundBlur}" />
                                <TextBlock Grid.Column="1" Classes="SliderValue"
                                           Text="{Binding #BlurSlider.Value, StringFormat={}{0:0}}" />
                            </Grid>
                            <Slider x:Name="BlurSlider" Classes="HideActiveTrack"
                                    TickFrequency="5" SmallChange="1" LargeChange="5"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding BackgroundBlur, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Classes="Field">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="FieldLabel" Text="{Tr SettingsDialog.Theme.BackgroundOpacity}" />
                                <TextBlock Grid.Column="1" Classes="SliderValue"
                                           Text="{Binding #OpacitySlider.Value, Converter={StaticResource CoefficientConverter}, ConverterParameter=100, StringFormat={}{0:0}%}" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Classes="HideActiveTrack"
                                    SmallChange="0.01" LargeChange="0.1"
                                    Minimum="0" Maximum="1"
                                    Value="{Binding BackgroundOpacity, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Classes="Field">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="FieldLabel" Text="{Tr SettingsDialog.Theme.Gamma}" />
                                <TextBlock Grid.Column="1" Classes="SliderValue"
                                           Text="{Binding #GammaSlider.Value, Converter={StaticResource CoefficientConverter}, ConverterParameter=100, StringFormat={}{0:0}%}" />
                            </Grid>
                            <Slider x:Name="GammaSlider" Classes="HideActiveTrack"
                                    SmallChange="0.01" LargeChange="0.1"
                                    Minimum="0" Maximum="1"
                                    Value="{Binding BackgroundGamma, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Classes="Field">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="FieldLabel" Text="{Tr SettingsDialog.Theme.LeftOpacity}" />
                                <TextBlock Grid.Column="1" Classes="SliderValue"
                                           Text="{Binding #LeftOpacitySlider.Value, Converter={StaticResource CoefficientConverter}, ConverterParameter=100, StringFormat={}{0:0}%}" />
                            </Grid>
                            <Slider x:Name="LeftOpacitySlider" Classes="HideActiveTrack"
                                    SmallChange="0.01" LargeChange="0.1"
                                    Minimum="0" Maximum="1"
                                    Value="{Binding LeftOpacity, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Classes="Field">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="FieldLabel" Text="{Tr SettingsDialog.Theme.RightOpacity}" />
                                <TextBlock Grid.Column="1" Classes="SliderValue"
                                           Text="{Binding #RightOpacitySlider.Value, Converter={StaticResource CoefficientConverter}, ConverterParameter=100, StringFormat={}{0:0}%}" />
                            </Grid>
                            <Slider x:Name="RightOpacitySlider" Classes="HideActiveTrack"
                                    SmallChange="0.01" LargeChange="0.1"
                                    Minimum="0" Maximum="1"
                                    Value="{Binding RightOpacity, Mode=TwoWay}" />
                        </StackPanel>

                        <CheckBox Content="{Tr SettingsDialog.Theme.DialogBlur}"
                                  IsChecked="{Binding ApplyBlurBackground}" />
                        <!-- SettingsDialog.Theme.RippleDisabled is not shown: there are no ripple animations.
                             SettingsVM.RippleDisabled / Settings.RippleDisabled stay for the settings.json round-trip. -->

                        <Button Theme="{DynamicResource OutlineButton}" Classes="Tertiary"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ResetThemeDefaultsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Restore" IconSize="16" />
                                <TextBlock Text="{Tr SettingsDialog.Theme.Reset}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
