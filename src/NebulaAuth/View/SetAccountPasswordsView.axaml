<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:nebulaAuth="using:NebulaAuth"
             xmlns:other="using:NebulaAuth.ViewModel.Other"
             mc:Ignorable="d"
             x:Class="NebulaAuth.View.SetAccountPasswordsView"
             x:DataType="other:SetAccountPasswordsVM"
             MinWidth="400" MaxWidth="400"
             MinHeight="500" MaxHeight="500"
             FontSize="15">
    <Grid RowDefinitions="Auto,*">

        <nebulaAuth:DialogHeader Grid.Row="0" IconKind="ShieldKey" Title="{Tr SetAccountPasswordsView.Title}" />

        <!-- Standard dialog body (DialogBody margins) and action row. Result box above the action, as in the other form
             dialogs (ProxyManager assignment, Exporter). No RowSpacing: collapsed rows would keep it, margins instead. -->
        <Grid Grid.Row="1" Classes="DialogBody" RowDefinitions="Auto,*,Auto,Auto,Auto">

            <!-- ===== ENCRYPTION PASSWORD SECTION ===== -->
            <Border Grid.Row="0" Classes="Card Flat" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Classes="FieldLabel" Margin="0,0,0,6"
                               Text="{Tr SetAccountPasswordsView.EncryptionPassword}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Margin="0,0,10,0"
                                 PlaceholderText="{Tr SetAccountPasswordsView.EnterPassword}"
                                 Text="{Binding EncryptionPassword}" />

                        <Button Grid.Column="1"
                                Theme="{StaticResource GhostIconButton}"
                                Classes="Primary"
                                ToolTip.Tip="{Tr Common.Save}"
                                Command="{Binding SetEncryptionPasswordCommand}">
                            <mi:MaterialIcon Kind="ContentSave" />
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="6">
                        <TextBlock Text="{Tr SetAccountPasswordsView.Status}" VerticalAlignment="Center" />
                        <mi:MaterialIcon Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsEncryptionPasswordSet}"
                                         Foreground="{DynamicResource SuccessBrush}"
                                         Kind="CheckBox" />
                        <mi:MaterialIcon Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding !IsEncryptionPasswordSet}"
                                         Foreground="{DynamicResource ErrorBrush}"
                                         Kind="CloseBox" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== ACCOUNTS INPUT ===== -->
            <TextBox Grid.Row="1"
                     FontSize="13"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Classes="TextArea clearButton"
                     PlaceholderText="{Tr SetAccountPasswordsView.InputFormat}"
                     Text="{Binding AccountsPasswords}" />

            <!-- ===== INFO TEXT ===== -->
            <TextBlock Grid.Row="2"
                       Margin="2,8,2,0"
                       Classes="FieldHelper"
                       Text="{Tr SetAccountPasswordsView.EncryptionHint}" />

            <!-- ===== HINT / RESULT BOX ===== -->
            <nebulaAuth:HintBox Grid.Row="3"
                                Margin="0,12,0,0"
                                IsVisible="{Binding Tip, Converter={x:Static ObjectConverters.IsNotNull}}"
                                CloseCommand="{Binding ClearTipCommand}"
                                Text="{Binding Tip}"
                                FontSize="13"
                                Severity="Info"
                                ShowCloseButton="True" />

            <StackPanel Grid.Row="4" Classes="DialogActions" Margin="0,14,0,0">
                <Button Theme="{DynamicResource SolidButton}" Classes="Primary"
                        Content="{Tr Common.Save}"
                        Command="{Binding SetPasswordsCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
