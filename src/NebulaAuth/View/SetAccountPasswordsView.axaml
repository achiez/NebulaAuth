<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:nebulaAuth="using:NebulaAuth"
             xmlns:other="using:NebulaAuth.ViewModel.Other"
             mc:Ignorable="d"
             x:Class="NebulaAuth.View.SetAccountPasswordsView"
             x:DataType="other:SetAccountPasswordsVM"
             MinWidth="400" MaxWidth="400"
             MinHeight="500" MaxHeight="500"
             FontSize="15">
    <Grid RowDefinitions="Auto,*">

        <nebulaAuth:DialogHeader Grid.Row="0" IconKind="ShieldKey" Title="{Tr SetAccountPasswordsView.Title}" />

        <!-- Standard dialog body (DialogBody margins) and action row. Result box above the action, as in the other form
             dialogs (ProxyManager assignment, Exporter). No RowSpacing: collapsed rows would keep it, margins instead. -->
        <Grid Grid.Row="1" Classes="DialogBody" RowDefinitions="Auto,*,Auto,Auto,Auto">

            <!-- ===== PASSWORD STORE STATE ===== -->
            <!-- Steam passwords are saved only in the encrypted password store: without encryption nothing can be saved -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="8">
                <nebulaAuth:HintBox FontSize="13" Severity="Warning"
                                    Text="{Tr SetAccountPasswordsView.EncryptionRequired}">
                    <nebulaAuth:HintBox.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!CanSavePasswords" />
                            <Binding Path="!SaveTurnedOff" />
                        </MultiBinding>
                    </nebulaAuth:HintBox.IsVisible>
                </nebulaAuth:HintBox>
                <!-- Encrypted storage, saving turned off by the user: mass set disabled until it is turned on again -->
                <nebulaAuth:HintBox FontSize="13" Severity="Warning"
                                    IsVisible="{Binding SaveTurnedOff}"
                                    Text="{Tr SetAccountPasswordsView.SavingTurnedOff}" />
                <Button Theme="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        IsVisible="{Binding !CanSavePasswords}"
                        Command="{Binding OpenEncryptionSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="ShieldLockOutline" IconSize="16" />
                        <TextBlock Text="{Tr SetAccountPasswordsView.OpenEncryptionSettings}" />
                    </StackPanel>
                </Button>
                <nebulaAuth:HintBox FontSize="13"
                                    IsVisible="{Binding CanSavePasswords}"
                                    Text="{Tr SetAccountPasswordsView.EncryptionOn}" />
            </StackPanel>
            <!-- ===== ACCOUNTS INPUT ===== -->
            <TextBox Grid.Row="1"
                     FontSize="13"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Classes="TextArea clearButton"
                     IsEnabled="{Binding CanSavePasswords}"
                     PlaceholderText="{Tr SetAccountPasswordsView.InputFormat}"
                     Text="{Binding AccountsPasswords}" />

            <!-- ===== INFO TEXT ===== -->
            <TextBlock Grid.Row="2"
                       Margin="2,8,2,0"
                       Classes="FieldHelper"
                       Text="{Tr SetAccountPasswordsView.EncryptionHint}" />

            <!-- ===== HINT / RESULT BOX ===== -->
            <nebulaAuth:HintBox Grid.Row="3"
                                Margin="0,12,0,0"
                                IsVisible="{Binding Tip, Converter={x:Static ObjectConverters.IsNotNull}}"
                                CloseCommand="{Binding ClearTipCommand}"
                                Text="{Binding Tip}"
                                FontSize="13"
                                Severity="Info"
                                ShowCloseButton="True" />

            <StackPanel Grid.Row="4" Classes="DialogActions" Margin="0,14,0,0">
                <Button Theme="{DynamicResource SolidButton}" Classes="Primary"
                        Content="{Tr Common.Save}"
                        Command="{Binding SetPasswordsCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
