<!--
    Embedded Steam browser of one account (Core/Browser/BrowserSession): minimal navigation bar (back, forward, reload,
    read-only address, close) over the native web view. While the session is prepared the loading panel is shown and the
    web view is kept at 1x1 px in the corner: a native web view is always drawn above Avalonia content, so it must not
    cover the loading panel, and it is revealed only after the page was verified to be signed in to the right account.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nebulaAuth="using:NebulaAuth"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="NebulaAuth.View.SteamBrowserWindow"
        Theme="{StaticResource NebulaWindow}"
        Title="Steam"
        Icon="/Theme/lock.ico"
        Width="1200" Height="820" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontSize="15">
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ===== Navigation bar ===== -->
        <Border Grid.Row="0" Classes="AppBar" Padding="8,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Theme="{StaticResource GhostIconButton}"
                            ToolTip.Tip="{Tr SteamBrowser.Back}" AutomationProperties.Name="{Tr SteamBrowser.Back}"
                            IsEnabled="False">
                        <mi:MaterialIcon Kind="ArrowLeft" />
                    </Button>
                    <Button x:Name="ForwardButton" Theme="{StaticResource GhostIconButton}"
                            ToolTip.Tip="{Tr SteamBrowser.Forward}" AutomationProperties.Name="{Tr SteamBrowser.Forward}"
                            IsEnabled="False">
                        <mi:MaterialIcon Kind="ArrowRight" />
                    </Button>
                    <Button x:Name="ReloadButton" Theme="{StaticResource GhostIconButton}"
                            ToolTip.Tip="{Tr SteamBrowser.Reload}" AutomationProperties.Name="{Tr SteamBrowser.Reload}"
                            IsEnabled="False">
                        <mi:MaterialIcon Kind="Refresh" />
                    </Button>
                </StackPanel>

                <!-- Current address (read-only: navigation happens only inside the page) -->
                <TextBox x:Name="AddressBox" Grid.Column="1" Classes="Subtle Mono" IsReadOnly="True"
                         VerticalAlignment="Center" FontSize="13"
                         AutomationProperties.Name="{Tr SteamBrowser.Address}">
                    <TextBox.InnerLeftContent>
                        <mi:MaterialIcon x:Name="AddressIcon" Classes="InputIcon" Kind="Web" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Account of this window -->
                    <Border Background="{DynamicResource PrimaryTintBrush}" CornerRadius="6" Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="AccountCircle" IconSize="16"
                                             Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock x:Name="AccountText" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CloseButton" Theme="{DynamicResource OutlineButton}" Classes="Tertiary"
                            Content="{Tr SteamBrowser.Close}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Short notice (e.g. a blocked sign-out or download) -->
        <nebulaAuth:HintBox x:Name="NoticeBox" Grid.Row="1" Margin="8,8,8,0" FontSize="13" Severity="Warning"
                            IsVisible="False" />

        <Panel x:Name="ContentHost" Grid.Row="2">
            <!-- The NativeWebView is added here by the session (first child, below the loading panel) -->

            <!-- ===== Loading ===== -->
            <Border x:Name="LoadingPanel" Classes="Card" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="28,24" MinWidth="360" MaxWidth="480">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <ProgressBar Theme="{DynamicResource ProgressRing}" IsIndeterminate="True" Width="36"
                                 Height="36" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoadingTitle" Classes="Heading" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="LoadingStatus" Classes="Muted" FontSize="14" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</Window>
