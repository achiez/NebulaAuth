<!-- NebulaAuth palette "LightTheme".
     Only the 21 palette colors live here; brushes and all derived tokens (Semi/Ursa mapping) are built
     from them at runtime by NebulaAuth.Theme.ThemeResources. Keys must stay identical in all 5 palettes. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#794DFF</Color>
    <Color x:Key="PrimaryContentColor">#f3f2ff</Color>
    <Color x:Key="SecondaryColor">#76717f</Color>
    <Color x:Key="SecondaryContentColor">#f7f7f8</Color>
    <Color x:Key="AccentColor">#3b82f6</Color>
    <Color x:Key="AccentContentColor">#eff6ff</Color>
    <Color x:Key="NeutralColor">#3f404d</Color>
    <Color x:Key="NeutralContentColor">#f8f8f9</Color>
    <Color x:Key="Base100Color">#ffffff</Color>
    <Color x:Key="Base200Color">#d6d5d9</Color>
    <Color x:Key="Base300Color">#3f404d</Color>
    <Color x:Key="BaseContentColor">#3f404d</Color>
    <Color x:Key="BaseShadowColor">#1e1e24</Color>
    <Color x:Key="InfoColor">#04b6d4</Color>
    <Color x:Key="InfoContentColor">#ecfeff</Color>
    <Color x:Key="SuccessColor">#00ca4b</Color>
    <Color x:Key="SuccessContentColor">#f0fcf8</Color>
    <Color x:Key="WarningColor">#fcaa1e</Color>
    <Color x:Key="WarningContentColor">#fffdf5</Color>
    <Color x:Key="ErrorColor">#fb4141</Color>
    <Color x:Key="ErrorContentColor">#fffaf5</Color>
</ResourceDictionary>
