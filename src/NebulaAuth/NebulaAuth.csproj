<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>NebulaAuth</AssemblyName>
		<RootNamespace>NebulaAuth</RootNamespace>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyVersion>1.8.5</AssemblyVersion>
		<ApplicationIcon>Theme\lock.ico</ApplicationIcon>
		<SatelliteResourceLanguages>en;ru;ua</SatelliteResourceLanguages>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<!-- Invariant globalization (Linux without libicu): themes and ControlsLocale create cultures such as zh-CN -->
		<PredefinedCulturesOnly>false</PredefinedCulturesOnly>
	</PropertyGroup>

	<!--
		Release packages are published self-contained per RID (win-x64, linux-x64, osx-x64, osx-arm64) by
		.github/workflows/publish.yml and packed with Velopack. The .NET runtime ships with the app because the 1.x updater
		only unpacks a ZIP and cannot install .NET 10. Single-file and trimming stay off: Velopack replaces the whole
		"current" folder, and trimming breaks reflection-based code (XAML, JSON, localization).
	-->
	<PropertyGroup>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.3" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
		<!-- Managed Argon2id: master password → key encryption key of the mafile storage (storage-state.json) -->
		<PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
		<PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
		<PackageReference Include="Semi.Avalonia.ColorPicker" Version="12.1.0.1" />
		<PackageReference Include="Irihi.Ursa" Version="2.2.0" />
		<PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.2.0" />
		<PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
		<PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="CodingSeb.Localization" Version="1.4.0" />
		<PackageReference Include="CodingSeb.Localization.JsonFileLoader" Version="1.4.0" />
		<PackageReference Include="NLog" Version="5.5.0" />
		<PackageReference Include="NLog.Extensions.Logging" Version="5.5.0" />
		<!-- Pinned: the update flow (portable layout, signed feed wrapper, apply/restart) was verified with this version -->
		<PackageReference Include="Velopack" Version="1.2.158" />
		<!-- Managed QR decoder (core library only, no platform bindings): Steam login QR from a clipboard image -->
		<PackageReference Include="ZXing.Net" Version="0.16.11" />
		<!-- Embedded Steam browser: WebView2 (Windows), WKWebView (macOS), WebKitGTK (Linux) -->
		<PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
		<!-- Managed CoreWebView2 wrapper over the native handle of NativeWebView (proxy auth, cookies, UA, process ids) -->
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SteamLibForked\SteamLibForked.csproj" />
		<ProjectReference Include="..\NebulaAuth.NebulaLink\NebulaAuth.NebulaLink.csproj" />
	</ItemGroup>

	<!--
		Only Microsoft.Web.WebView2.Core is used (wrapper over the NativeWebView handle): the package's WinForms / WPF
		controls are not referenced (they pull WPF's WindowsBase and are never loaded).
	-->
	<Target Name="RemoveWebView2UiControls" BeforeTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
		</ItemGroup>
	</Target>

	<!-- Images used by the UI (splash, background, icons) are embedded as avares:// resources -->
	<ItemGroup>
		<AvaloniaResource Include="Theme\Background.png;Theme\SplashScreen.png;Theme\lock.ico" />
	</ItemGroup>

	<!-- DevTools (previews, demo data, debug hooks; see DevTools/README.md) is part of Debug builds only -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<AvaloniaResource Include="DevTools\Demo\Assets\*.png" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' != 'Debug'">
		<Compile Remove="DevTools\**" />
		<AvaloniaXaml Remove="DevTools\**" />
	</ItemGroup>

	<!-- Design sources (*.psd) stay in the project as plain None items (default globbing), never copied to output -->

	<ItemGroup>
		<None Update="Localization\*.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="NLog.config">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
