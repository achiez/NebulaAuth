<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwExceptions="false">

	<targets>
		<!--
			Logs are written to the data folder (NebulaAuth.Core.DataRoot sets the NebulaLogDir item before the first log
			entry), never to the program folder: under Velopack that folder is replaced on update, and on macOS/Linux it is
			read-only. The temp folder is only used if the app fails before the data folder is known.
		-->
		<target xsi:type="File"
		        name="File"
		        fileName="${gdc:item=NebulaLogDir:whenEmpty=${tempdir}/NebulaAuth/logs}/log-${shortdate}.log"
		        concurrentWrites="true"
		        keepFileOpen="false">
			<layout xsi:type='CompoundLayout'>
				<layout xsi:type="JsonLayout" includeEventProperties="true" IncludeScopeProperties="true">
					<attribute name="time" layout="${longdate}" />
					<attribute name="level" layout="${level:upperCase=true}" />
					<attribute name="message" layout="${message}" />
					<attribute name="exception" layout="${exception:format=@}" encode="false" />
				</layout>
				<layout type='SimpleLayout' text="," />
			</layout>
		</target>
	</targets>

	<rules>
		<logger name="*" minlevel="Trace" writeTo="File" />
	</rules>
</nlog>